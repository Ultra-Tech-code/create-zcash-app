Describing zebra.indexer.rpc.Indexer service:
zebra.indexer.rpc.Indexer is a service:
service Indexer {
  // Notifies listeners of chain tip changes
  rpc ChainTipChange ( .zebra.indexer.rpc.Empty ) returns ( stream .zebra.indexer.rpc.BlockHashAndHeight );
  // Returns the block with the given hash or height from the best chain.
  //
  // Used by a syncer to fetch finalized blocks that bridge the gap between its
  // local finalized tip and the start of the streamed non-finalized chain.
  rpc GetBlock ( .zebra.indexer.rpc.BlockRequest ) returns ( .zebra.indexer.rpc.BlockAndHash );
  // Notifies listeners of mempool changes
  rpc MempoolChange ( .zebra.indexer.rpc.Empty ) returns ( stream .zebra.indexer.rpc.MempoolChangeMessage );
  // Notifies listeners of new blocks in the non-finalized state.
  //
  // Callers may provide the hashes of the chain tips they already have so the
  // server only streams blocks after those tips. An empty request streams every
  // block currently in the non-finalized state.
  rpc NonFinalizedStateChange ( .zebra.indexer.rpc.NonFinalizedStateChangeRequest ) returns ( stream .zebra.indexer.rpc.BlockAndHash );
}

