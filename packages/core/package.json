{
  "name": "@zcash-app/core",
  "version": "0.1.0-alpha.1",
  "description": "Rust crypto core for create-zcash-app: trial-decryption, key derivation, and proving",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ultra-Tech-code/create-zcash-app.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Ultra-Tech-code/create-zcash-app#readme",
  "bugs": {
    "url": "https://github.com/Ultra-Tech-code/create-zcash-app/issues"
  },
  "keywords": [
    "zcash",
    "shielded",
    "orchard",
    "ironwood",
    "nu7",
    "crypto",
    "rust",
    "napi"
  ],
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "napi": {
    "binaryName": "zcash-core",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublish": "napi pre-publish --dry-run --tag-style npm",
    "test": "cargo test"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0"
  }
}
